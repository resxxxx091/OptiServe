# 构建上下文 = 仓库根。BuildKit 只读取这一份 .dockerignore（context 根的），
# 子目录下再放 .dockerignore 不会生效。
# 用法：docker build -f deploy/Dockerfile -t optiserve-frontend .

# ---- 版本控制与编辑器 ----
.git/
.idea/
.vscode/
.superpowers/
.DS_Store
Thumbs.db

# ---- 个人文档，与构建无关 ----
hht/

# ---- 密钥：容器配置由 compose 的 env_file 注入，不打进镜像层 ----
**/.env
**/.env.local
!**/.env.example

# ---- 前端：产物在容器里 npm ci + build 生成 ----
# 宿主这份 dist/ 可能来自别处或早已过期，不能让它的 mtime 骗过缓存
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- 后端：本机虚拟环境体积大且是 Windows 平台产物；其余是缓存与运行期数据 ----
backend/.venv/
backend/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
backend/logs/
backend/data/
backend/tests/
backend/*.sqlite3

# ---- 通用 ----
**/*.log
**/*.bak
**/*~
