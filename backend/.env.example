# OptiServe 环境变量模板
#
# 用法：cp .env.example .env  然后填真实值。
# .env 及任何 .env.* 变体都被 .gitignore 忽略（如: .env* + !.env.example），不要提交。
#
# 起中间件栈（工作目录 = deploy/）：
#   docker compose --env-file ../backend/.env up -d
# 不用加 --build；前后端都不在容器里跑。
#
# 启动闸门：LLM / embedding / reranker / Redis / Milvus 任一失败直接抛错让 uvicorn 退出（不是降级服务）。

# 应用 ─────────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
# 只对本机直跑 `python -m api.main` 生效（后端不在容器里，deploy/ 只编排中间件）。
# 默认只听回环：加上 OPTISERVE_API_TOKEN 才考虑往外开。
API_HOST=127.0.0.1
API_PORT=8000

# ── Agent 配置 ────────────────────────────────────────────────
OPTISERVE_AGENT_LOOP_TIMEOUT_S=90 # 单个 Agent 跑完一次工具循环的总时限。
OPTISERVE_ROUTING_DEMOTE_THRESHOLD=0.5 # Agent 的 penalty 达到这个值就不再当主 Agent

# ── DeepSeek（langchain-deepseek / OpenAI 兼容端点）────────────────────────────
DEEPSEEK_API_KEY=sk-f5e0498cd9644076b00bba5aa4891e4f
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── LangFuse ────────────────────────────────────────────────────
# 没配齐密钥（或是占位值）就不上报，本次运行不留任何请求链路记录。
LANGFUSE_SECRET_KEY="sk-lf-a9a9daae-d43e-4850-8441-8c454796507f"
LANGFUSE_PUBLIC_KEY="pk-lf-571f50be-5e4c-464f-8b92-8f567e121244"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# ── 访问令牌与跨源（可选，不设即不启用鉴权）──────────────────────────────────────
# 生成一条真实的 API 令牌：python -c "import secrets;print(secrets.token_urlsafe(32))"
OPTISERVE_API_TOKEN=sIN7v47QqkMWev6R-G5xdKpZZfRrP13WtMXr8omUd4E
# 逗号分隔的允许源。前端默认走 Vite dev server 的 /api/python 代理（同源，CORS 不参与），
# 所以只有当前端直接配后端绝对地址、或用 127.0.0.1 / 局域网 IP 打开页面时才需要加源，
# 例如 http://127.0.0.1:5173,http://192.168.1.10:5173。刻意不提供 * 回退。
OPTISERVE_ALLOWED_ORIGINS=http://localhost:5173



# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=hht
REDIS_URL=redis://:hht@localhost:6379/0

# ── Milvus ─────────────────────────────────────────────────────────────────────0
MILVUS_TOKEN=
MILVUS_DB_NAME=hht
MILVUS_URI=http://localhost:19530



# ── Embedding ────────────────────────────────────────────────────────────
# 必填。Milvus 不生成向量，向量由这里配置的服务产出；例如 https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embedding
EMBEDDING_API_KEY=sk-nhoggqgxihtlqiiajdvvauobcneldrgfeqytosmxgbwttamt

# ── Reranker ────────────────────────────────────────────────────────────────────────
# 必填。检索链路的最后一级，没有降级路径：端点不通直接拒绝启动。例如 https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=sk-nhoggqgxihtlqiiajdvvauobcneldrgfeqytosmxgbwttamt

# ── 检索链路 ─────────────────────────────────────────────────────────────────
RETRIEVAL_RRF_K=60 # RRF 粗排：score = Σ 各路权重 / (RRF_K + 该路名次)
RETRIEVAL_RRF_DENSE_WEIGHT=0.7
RETRIEVAL_RRF_SPARSE_WEIGHT=0.3
# 每个子查询在每路索引上取多少条候选；粗排融合后送进精排多少条
RETRIEVAL_RECALL_K=10
RETRIEVAL_COARSE_N=20
# 断崖截断：精排分相邻两名落差满足任一阈值就在那里切断，不再固定取满 top-K
RERANK_MAX_TOPK=10
RERANK_MIN_TOPK=1
# 两个阈值是 OR（满足任一即切断），按精排的 [0,1] 概率分重量纲：head<=1 时
# 相对阈值 0.25*head 恒不大于绝对阈值 0.5，所以切断点总是先由 GAP_RATIO 命中，
# 改 GAP_ABS 在评测里看不出差异是当前的预期行为。GAP_ABS 只在端点返回未归一化
# 分数量纲（例如 C 端自建的原始 logit）时才可能单独生效。
RERANK_GAP_ABS=0.5
RERANK_GAP_RATIO=0.25
# 送进精排的单篇文档截断长度
RERANK_MAX_CHARS=1000
# 超时：单次 handler 执行由每个工具的 timeout_s（代码里，默认 30s）管，这两项管剩下的两层——
# 一次改写 LLM 调用、以及整条五级链之和。总预算要小于「单跳超时之和」，让降级先于卡死发生；
# 命中后整次检索判失败并打降级事件（tool/retrieval_timeout、llm/rewrite_timeout），不抛穿到 HTTP 层。
RETRIEVAL_REWRITE_TIMEOUT_S=15
RETRIEVAL_TOTAL_TIMEOUT_S=45

# ── Monitor ──────────────────────────────────────────────────────────────────────
MONITOR_INTERVAL=10
OPTISERVE_MONITOR_ALERT_MAX=200
OPTISERVE_MONITOR_SUGGESTION_MAX=50
