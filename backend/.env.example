# OptiServe 环境变量模板
#
# 用法：cp .env.example .env  然后填真实值。
# .env 已被 .gitignore 忽略（规则 .env 对任意层级生效），不要提交。
#
# 全项目只有这一份 .env：后端进程用 load_dotenv() 从 backend/ 读它，中间件栈用 --env-file 读它。
#
# 起中间件栈（工作目录 = 仓库根的 deploy/）：
#   docker compose --env-file ../backend/.env up -d
# 这里的 --env-file 不是可选的：compose 的 ${REDIS_PASSWORD} 插值只读 project 目录
# （deploy/）下的 .env 与 shell 环境，不带这个参数 compose 会直接报缺变量。
# 栈里没有需要构建的服务，不要加 --build；后端不在容器里跑。
#
# ── 启动闸门：下面标了「必填」的六项任一为空或不通，后端进程会拒绝启动 ──────────
# api/main.py 的 lifespan 会逐个真实探测 LLM / embedding / reranker / Redis / Milvus，
# 任一失败直接抛错让 uvicorn 退出（不是降级服务）。这是有意设计，不要改。

# ── DeepSeek（langchain-deepseek / OpenAI 兼容端点）────────────────────────────
# 必填
DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-v4-flash
# 必须是 OpenAI 兼容根并带 /v1（不是 /anthropic）；客户端不会自动补 /v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── LangSmith（自托管环境一律关掉回连）────────────────────────────────────────
# 不设 false 时 LangChain SDK 会尝试连 api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
# 必须大写：api/main.py 用 getattr(logging, LOG_LEVEL) 取级别，写小写会在日志器建立前抛 AttributeError
LOG_LEVEL=INFO
# 注：API_HOST/API_PORT 只在 `python api/main.py` 直跑时生效；
# 容器里 CMD 走 uvicorn --host/--port 硬编码 0.0.0.0:8000，这两项不起作用。
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
# 必填：compose 用它同时给 redis-server 设 requirepass 并拼进 REDIS_URL，缺失即报错，
# 不再有 optiserve123 这种内置兜底。
REDIS_PASSWORD=change-me
# docker compose 内部地址（容器间通信）；compose 的 environment 会用它覆盖本行
REDIS_URL=redis://:change-me@localhost:6379/0

# ── Milvus（情景记忆 + 用户画像 + RAG 知识库）─────────────────────────────────
# docker compose 内部地址（容器间通信）；本机调试改成 http://localhost:19530
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default

# ── Embedding（OpenAI 兼容 /v1/embeddings）───────────────────────────────────
# 必填。Milvus 不生成向量，向量由这里配置的服务产出；例如 https://api.siliconflow.cn/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# 必须与模型输出维度一致；换模型/维度需要先删除 Milvus 里对应的 collection
EMBEDDING_DIM=1024
# 知识库的混合索引要求同一个模型同时给得出稀疏向量（bge-m3 支持）。
# 服务端要请求体里带开关才返回稀疏时，把字段名写在这里；置空表示不需要开关、直接返回。
EMBEDDING_SPARSE_PARAM=return_sparse

# ── Reranker（Cohere/Jina 兼容 /v1/rerank，检索精排）───────────────────────────
# 必填。检索链路的最后一级，没有降级路径：端点不通直接拒绝启动。例如 https://api.siliconflow.cn/v1
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 不单独配时沿用 EMBEDDING_API_KEY（同一平台同一密钥）
RERANK_API_KEY=
RERANK_TIMEOUT_S=10

# ── 检索链路阈值（改完重启生效，评测调参用）─────────────────────────────────────
# RRF 粗排：score(文档) = Σ 各路权重 / (RRF_K + 该路名次)，只用名次所以稠密/稀疏可同台融合
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_DENSE_WEIGHT=0.7
RETRIEVAL_RRF_SPARSE_WEIGHT=0.3
# 每个子查询在每路索引上取多少条候选；粗排融合后送进精排多少条
RETRIEVAL_RECALL_K=10
RETRIEVAL_COARSE_N=20
# 断崖截断：精排分相邻两名落差满足任一阈值就在那里切断，不再固定取满 top-K
RERANK_MAX_TOPK=10
RERANK_MIN_TOPK=1
RERANK_GAP_ABS=0.5
RERANK_GAP_RATIO=0.25
# 送进精排的单篇文档截断长度
RERANK_MAX_CHARS=1000

# ── 监控 ──────────────────────────────────────────────────────────────────────
# 注：这里不设 PROMETHEUS_PORT / ALERT_WEBHOOK_URL。应用侧没有 /metrics 端点，
# 也没有任何代码读取这两个键；可观测面是 GET /monitor 与 GET /health。
MONITOR_INTERVAL=10

# ── 路由降权（Monitor → Orchestrator 闭环）────────────────────────────────────
# Agent 的 penalty 达到这个值就不再当主 Agent，改选意图合法的健康备选（GENERAL 兜底）
OPTISERVE_ROUTING_DEMOTE_THRESHOLD=0.5

# ── Trace 与 Langfuse 上报 ────────────────────────────────────────────────────
# 本地环形缓冲留多少棵 span 树（GET /trace/recent 与 /trace/{id} 读它）
OPTISERVE_TRACE_TREE_MAX=200
# 三个都不配（或落在占位值集合里）时导出器为 None：span 树只留在本地，请求链路零影响。
# 注意别填成 pk-lf-xxxxxxxx 这种串 —— 它不在占位值集合里，会被当成真密钥去连。
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=https://cloud.langfuse.com
