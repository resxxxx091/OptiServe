# OptiServe 环境变量模板
#
# 用法：cp .env.example .env  然后填真实值。
# .env 及任何 .env.* 变体都被 .gitignore 忽略（如: .env* + !.env.example），不要提交。
#
# 起中间件栈（工作目录 = deploy/）：
#   docker compose --env-file ../backend/.env up -d
# 不用加 --build；前后端都不在容器里跑。
#
# 启动闸门：LLM / embedding / reranker / Redis / Milvus 任一失败直接抛错让 uvicorn 退出（不是降级服务）。

# ── 应用 ─────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# 生成一条真实的 API 令牌：python -c "import secrets;print(secrets.token_urlsafe(32))"
OPTISERVE_API_TOKEN=
# 允许跨域的前端地址，多个用逗号分隔；生产环境改成前端域名。
OPTISERVE_ALLOWED_ORIGINS=http://localhost:5173 

# ── Agent 配置 ───────────────────────────────────────────────────────────────────
OPTISERVE_AGENT_LOOP_TIMEOUT_S=90 # 单个 Agent 跑完一次工具循环的总时限。
OPTISERVE_ROUTING_DEMOTE_THRESHOLD=0.5 # Agent 的 penalty 达到这个值就不再当主 Agent

# ── DeepSeek（langchain-deepseek / OpenAI 兼容端点）─────────────────────────────── 
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=hht
REDIS_URL=redis://:hht@localhost:6379/0

# ── Milvus ─────────────────────────────────────────────────────────────────────
MILVUS_DB_NAME=default
MILVUS_URI=http://localhost:19530

# ── Embedding ────────────────────────────────────────────────────────────
# 必填。Milvus 不生成向量，向量由这里配置的服务产出；例如 https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=

# ── Reranker ────────────────────────────────────────────────────────────────────────
# 必填。检索链路的最后一级，没有降级路径：端点不通直接拒绝启动。例如 https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=

# ── 检索链路 ─────────────────────────────────────────────────────────────────
RETRIEVAL_RRF_K=60 # RRF 粗排：score = Σ 1 / (RRF_K + 该路名次)，各路等权
RETRIEVAL_RECALL_K=10 # 每个子查询在每路索引上取多少条候选
RETRIEVAL_COARSE_N=20 # 粗排融合后送进精排多少条
# 断崖截断：只由这两个落差阈值决定切在哪，不设保留篇数
RERANK_GAP_ABS=0.5
RERANK_GAP_RATIO=0.25
RERANK_MAX_CHARS=1000 # 送进精排的单篇文档截断长度
# 链路超时
RETRIEVAL_REWRITE_TIMEOUT_S=20
RETRIEVAL_TOTAL_TIMEOUT_S=60

# ── Monitor ──────────────────────────────────────────────────────────────────────
MONITOR_INTERVAL=10 # 监控间隔，单位秒

# ── LangFuse ───────────────────────────────────────────────────────────────────── 
# 没配齐密钥（或是占位值）就不上报，本次运行不留任何请求链路记录。
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
VITE_LANGFUSE_PROJECT_URL= # Langfuse 项目页，形如 https://<host>/project/<projectId>
